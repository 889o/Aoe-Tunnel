# ---- Panel ----
PANEL_HTTP_ADDR=:8080
# 站点公网地址；也可在「系统设置-站点信息」里配置（优先于环境变量）
PANEL_PUBLIC_URL=https://panel.example.com
# 下发给 Agent 的 MQTT 接入地址，需远端可达
PANEL_AGENT_BROKER=ssl://panel.example.com:8883
PANEL_API_KEY=change-me-please
MYSQL_DSN=aoe:aoePass2026@tcp(127.0.0.1:3306)/aoe_tunnel?charset=utf8mb4&parseTime=True&loc=Local
MQTT_BROKER=ssl://127.0.0.1:8883
MQTT_CA=deploy/certs/ca.crt
MQTT_SNI=aoe-node
MQTT_USER=
MQTT_PASS=
LOG_LEVEL=info
LOG_FORMAT=console

# ---- Agent ----
AGENT_NODE_CODE=n-entry
# 控制面地址（面板公网地址），必填
PANEL_API_URL=https://panel.example.com
# 数据面：Ingress/Egress 之间的 QUIC/TLS 监听端口
AGENT_QUIC_ADDR=:9613
AGENT_TLS_ADDR=:9614
AGENT_LISTEN_HOST=0.0.0.0
AGENT_CERT_FILE=deploy/certs/server.crt
AGENT_KEY_FILE=deploy/certs/server.key
AGENT_CLIENT_CERT_FILE=deploy/certs/client.crt
AGENT_CLIENT_KEY_FILE=deploy/certs/client.key
AGENT_CA_FILE=deploy/certs/ca.crt
AGENT_SNI=aoe-node
AGENT_DATA_DIR=data
AGENT_FORCE_FALLBACK=false
AGENT_REPORT_INTERVAL=2s
